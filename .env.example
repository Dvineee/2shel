# ==============================================================================
# SPONSORHUB - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Not: Canlı ortama veya sunucuya yüklerken bu dosyanın adını '.env' yaparak
# gerçek anahtarlarınızı giriniz.

# ------------------------------------------------------------------------------
# 1. SUPABASE VERİTABANI & AUTH (Zorunlu / Önerilen)
# ------------------------------------------------------------------------------
# Supabase Dashboard -> Settings -> API bölümünden temin edebilirsiniz.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT ENTEGRASYONU (Opsiyonel)
# ------------------------------------------------------------------------------
# Yeni çekiliş, sponsor ve admin bildirimleri için @BotFather ile oluşturulan token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Opsiyonel / Server-Side)
# ------------------------------------------------------------------------------
# AI destekli içerik ve sponsor analizleri için Google AI Studio API anahtarı
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 4. SUNUCU & ORTAM AYARLARI
# ------------------------------------------------------------------------------
NODE_ENV=production
