# ==============================================================================
# SHELBY ONLINE - Apache & LiteSpeed Production Configuration (.htaccess)
# ==============================================================================

# 1. Disable Directory Browsing & MultiViews
Options -Indexes -MultiViews

# 2. UTF-8 Encoding
AddDefaultCharset UTF-8
DefaultLanguage tr-TR

# 3. URL Canonicalization & React SPA Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # A. Canonical Redirection: Force HTTPS and Force Non-WWW (301 Permanent)
  # ----------------------------------------------------------------------
  # 1. Redirect HTTP to HTTPS OR www.shelbyonline.com to https://shelbyonline.com
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.shelbyonline\.com$ [NC]
  RewriteRule ^(.*)$ https://shelbyonline.com/$1 [L,R=301]

  # ----------------------------------------------------------------------
  # B. Generic WWW to Non-WWW fallback for any custom domain
  # ----------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # ----------------------------------------------------------------------
  # C. Do NOT rewrite existing physical files, directories or symlinks
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------
  # D. React SPA Fallback: Route all other requests to index.html
  # ----------------------------------------------------------------------
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# 4. Error Documents Fallback
ErrorDocument 404 /index.html

# 5. Security & Privacy Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# 7. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & JSON & Manifest (Always fresh for SPA updates & SEO)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"

  # CSS & JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Images & Icons
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 8. MIME Types
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  AddType font/woff woff
  AddType font/woff2 woff2
</IfModule>
